# ==============================================================================
# Database Configuration (Prisma + pg → PostgreSQL)
# ==============================================================================
# Local Docker (this repo uses port 5434 if 5432 is taken):
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/triage_db?schema=public"

# Neon pooled URL (sslmode=require). Do not commit real credentials.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/ats?sslmode=require"

# ==============================================================================
# Server AI credentials (never expose these to the client)
# Default provider — required for production ATS scoring
# ==============================================================================
FIREWORKS_API_KEY=""
FIREWORKS_MODEL="accounts/fireworks/models/deepseek-v4-flash-0731"

# Optional fallback only if FIREWORKS_API_KEY is unset (not the default)
# GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""
# GOOGLE_GENERATIVE_AI_MODEL="gemini-2.0-flash"
